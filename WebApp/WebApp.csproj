<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>PereneTts</RootNamespace>
    <!-- Docker restores the project before copying Razor files. Include framework assets at restore time. -->
    <RequiresAspNetWebAssets>true</RequiresAspNetWebAssets>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <!-- Desktop mode only (native window on macOS); its native library is never loaded in web mode. -->
    <PackageReference Include="Photino.NET" Version="4.0.16" />
  </ItemGroup>
</Project>
