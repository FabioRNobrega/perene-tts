@implements IAsyncDisposable
@inject IJSRuntime JS
<div class="audio-player" @ref="root" role="group" aria-label="Audio player">
    <audio preload="@Preload" src="@Src"></audio>
    <button type="button" class="player-button" data-action="play" aria-label="Play" title="Play"><i class="bi bi-play-fill" aria-hidden="true"></i></button>
    <output class="time-readout" data-role="current" aria-label="Elapsed time">0:00</output>
    <input class="timeline" type="range" min="0" max="0" step="0.01" value="0" aria-label="Playback position" disabled />
    <span class="time-readout" data-role="duration" aria-label="Total duration">0:00</span>
    <button type="button" class="player-button" data-action="mute" aria-label="Mute" title="Mute" aria-pressed="false"><i class="bi bi-volume-up-fill" aria-hidden="true"></i></button>
    <input class="volume" type="range" min="0" max="1" step="0.01" value="1" aria-label="Volume" />
</div>
@code {
    [Parameter, EditorRequired] public string Src { get; set; } = "";
    [Parameter] public string Preload { get; set; } = "metadata";
    private ElementReference root;
    private IJSObjectReference? module;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try
        {
            module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/audio-player.js");
            await module.InvokeVoidAsync("attach", root);
        }
        catch (JSException) { }
    }

    public async ValueTask DisposeAsync()
    {
        try { if (module is not null) await module.DisposeAsync(); }
        catch (JSDisconnectedException) { }
    }
}
