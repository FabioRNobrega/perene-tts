@inherits LayoutComponentBase
@implements IDisposable
@inject StudioSession Studio
@inject NavigationManager Navigation
@inject IHostShell Shell
<a class="skip-link" href="#main-content">Skip to content</a>
<div class="app-shell @(light ? "light" : "")">
    <aside class="sidebar" aria-label="Primary navigation">
        <a class="brand" href="/" aria-label="PereneTTS home"><i class="bi bi-soundwave" aria-hidden="true"></i><strong>PereneTTS</strong></a>
        <nav>
            <NavLink href="/" Match="NavLinkMatch.All"><i class="bi bi-mic" aria-hidden="true"></i><span>Create a voice</span></NavLink>
            <NavLink href="generate-audio"><i class="bi bi-file-earmark-text" aria-hidden="true"></i><span>Generate audio</span></NavLink>
            <NavLink href="batch-audio"><i class="bi bi-files" aria-hidden="true"></i><span>Batch audio</span></NavLink>
            <NavLink href="creations"><i class="bi bi-collection-play" aria-hidden="true"></i><span>My creations</span></NavLink>
        </nav>
        <div class="sidebar-footer">
            <div class="privacy"><span><i class="bi bi-shield-lock" aria-hidden="true"></i> Private · local only</span><label class="theme-switch" title="@(light ? "Switch to dark mode" : "Switch to light mode")"><input type="checkbox" role="switch" checked="@(!light)" @onchange="() => light = !light" aria-label="@(light ? "Switch to dark mode" : "Switch to light mode")" /><i class="bi @(light ? "bi-sun-fill" : "bi-moon-stars-fill")" aria-hidden="true"></i></label></div>
            <div class="batch-status" role="status" aria-live="polite">@if (Studio.ActiveBatch is { } active) { <a href="@BatchRules.OpenBatchUrl(active.BatchId)"><i class="bi bi-files" aria-hidden="true"></i> @BatchRules.SidebarStatus(active)</a> }</div>
            <div class="engine-status" role="status"><span class="dot @(Studio.Health?.ModelReady == true ? "ready" : "")"></span><span>@Studio.HealthText</span></div>
            <small>Copyright © @DateTime.UtcNow.Year PereneTech.</small>
        </div>
    </aside>
    <main id="main-content" class="main-content" tabindex="-1">
        <ErrorBoundary @ref="boundary"><ChildContent>
            @if (Studio.Error is not null)
            {
                <div class="alert" role="alert"><span>@Studio.Error</span><button class="quiet" @onclick="() => Studio.SetError(null)">Dismiss</button></div>
            }
            <div class="notice-region" role="status" aria-live="polite">
                @if (Studio.Notice is not null)
                {
                    <div class="notice"><span><i class="bi bi-check-circle" aria-hidden="true"></i> @Studio.Notice</span><button class="quiet" @onclick="() => Studio.SetNotice(null)">Dismiss</button></div>
                }
            </div>
            @Body
            <GenerationOutput />
        </ChildContent><ErrorContent><div class="alert" role="alert">The studio encountered an error. <a href="/">Reload the studio</a>.</div></ErrorContent></ErrorBoundary>
    </main>
    @* Inside the themed shell so the dialog follows the light/dark appearance. *@
    <ConfirmDialog Open="@(closing is not null)" Title="@(closing is null ? "" : DesktopRules.Title(closing))" ConfirmLabel="@(closing is null ? "" : DesktopRules.ConfirmLabel(closing))"
                   CancelLabel="@DesktopRules.KeepWorking" Icon="bi-box-arrow-right" OnCancel="KeepWorking" OnConfirm="ConfirmClose">
        @if (closing?.Kind == CloseKind.ConfirmStopBatches)
        {
            <p>Quitting stops @(closing.Batches.Count == 1 ? "this conversion" : "these conversions"):</p>
            <ul>@foreach (var batch in closing.Batches) { <li>@batch.Name</li> }</ul>
            <p class="hint">@DesktopRules.TracksKept</p>
        }
        @if (closing?.GenerationRunning == true) { <p>@DesktopRules.GenerationLost</p> }
    </ConfirmDialog>
</div>
@code {
    private bool light;
    private ErrorBoundary? boundary;
    private CloseDecision? closing;
    protected override void OnInitialized()
    {
        Studio.Changed += Changed;
        Navigation.LocationChanged += Navigated;
        Shell.CloseRequested += CloseRequested;
    }
    // Desktop: the window asks before closing while work would be lost; the page acknowledges so the host does not ask too.
    private Task CloseRequested(CloseRequest request) => InvokeAsync(async () =>
    {
        request.Acknowledge();
        await Studio.Refresh();
        // An unreachable worker has nothing left to stop cleanly.
        var decision = Studio.Health is null ? null : DesktopRules.Decide(Studio.Busy, Studio.Batches);
        if (decision is null || decision.Kind == CloseKind.CloseNow) { Shell.CompleteClose(); return; }
        closing = decision;
        StateHasChanged();
    });
    private void KeepWorking() => closing = null;
    private async Task ConfirmClose()
    {
        closing = null;
        await Studio.Refresh();
        if (Studio.Health is null) { Shell.CompleteClose(); return; }
        foreach (var batch in Studio.Batches.Where(batch => DesktopRules.BlocksClose(batch.State)).ToList())
            if (!await Studio.StopBatch(batch.BatchId)) return;
        if (Studio.Batches.Any(batch => DesktopRules.BlocksClose(batch.State)))
        {
            Studio.SetError("A conversion is still running. Try closing again.");
            return;
        }
        Shell.CompleteClose();
    }
    protected override void OnAfterRender(bool firstRender) { if (firstRender) Studio.Start(); }
    private void Changed() => _ = InvokeAsync(StateHasChanged);
    private void Navigated(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs args) => boundary?.Recover();
    public void Dispose() { Studio.Changed -= Changed; Navigation.LocationChanged -= Navigated; Shell.CloseRequested -= CloseRequested; }
}
